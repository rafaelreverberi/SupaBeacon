{
  "name": "supabeacon",
  "version": "1.0.0",
  "description": "Self-hosted Supabase activity manager with automatic project discovery, scheduled database heartbeats, OAuth integration, and a modern web dashboard.",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx apps/server/src/index.ts",
    "dev:web": "vite",
    "init": "node scripts/init.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test apps/server/tests/*.test.ts",
    "test:e2e": "playwright test",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node --env-file-if-exists=.env dist/server/apps/server/src/index.js",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:check": "node scripts/check-secrets.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "@tanstack/react-query": "5.104.3",
    "argon2": "0.45.1",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "lucide-react": "1.58.0",
    "luxon": "3.7.2",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/luxon": "3.7.6",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12"
  }
}
