# Generate real values with npm run init or ./setup.sh. Never commit .env.
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
SETUP_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# auto: HTTP browser port follows DASHBOARD_PORT; HTTPS stays fixed.
# explicit: preserve APP_URL exactly (e.g. a different SSH tunnel / HTTP proxy port).
APP_URL=http://localhost:8080
APP_URL_MODE=auto
BIND_ADDRESS=127.0.0.1
DASHBOARD_PORT=8080
HOST=127.0.0.1
PORT=8080
DATABASE_PATH=data/supabeacon.db
TIMEZONE=Europe/Zurich
HEARTBEATS_PER_DAY=2
REQUESTS_PER_HEARTBEAT=2
AUTO_ENABLE=true
# Explicit proxy IP/CIDR only, never a blanket true behind an untrusted network.
# TRUST_PROXY=172.20.0.2
